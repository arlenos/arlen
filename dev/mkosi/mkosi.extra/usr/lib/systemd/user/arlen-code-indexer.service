[Unit]
Description=Arlen code-graph indexer (user service)
Documentation=https://github.com/arlenos/arlen
# arlen-code-indexer is the Tier-2 code-graph ingestion daemon (code-graph-layer.md
# CG-R1/CG-R3). It consumes file.opened from the event bus and, for each changed,
# project-scoped source file (Rust, Python, TypeScript), re-parses ONLY that file
# (tree-sitter, per-file isolation) and emits a code.indexed event the knowledge
# daemon promotes into CodeSymbol + DEFINES. Per-user daemon: it reads the user's
# own project source and emits onto the per-uid event bus. Cross-file resolution
# is CG-R2.

[Service]
Type=notify
# The system sockets, pinned here rather than inherited.
#
# `arlen-session` exports these and then calls `systemctl --user import-environment`,
# but a unit wanted by `default.target` is already running by then, and an import
# does not reach a live service. On a booted image this daemon looped on
# "No such file or directory" against $XDG_RUNTIME_DIR/arlen/, 83 times in three
# minutes, while the bus listened under /run/arlen the whole time.
#
# `arlen-ai-engine-daemon.service` already pins its sockets this way; this is that
# pattern, applied where a boot log showed it was missing.
# NO SOCKET PINS since 15 Aug: the bus is a per-user service, so the SDK's default
# of $XDG_RUNTIME_DIR/arlen/ is where it actually binds. These lines used to point
# at /run/arlen because the bus was a system unit, and a user service that did not
# pin them dialled a path nothing bound - silently, forever. Keeping them now would
# recreate that defect pointing the other way.
Environment=ARLEN_KNOWLEDGE_SOCKET=/run/arlen/knowledge.sock
ExecStart=/usr/lib/arlen/libexec/arlen-code-indexer
Restart=on-failure
RestartSec=2

# It READS project source under the home and talks only over AF_UNIX (the
# event-bus producer + the knowledge read socket); it writes nothing under the
# home, so ProtectHome=read-only is sufficient.
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
