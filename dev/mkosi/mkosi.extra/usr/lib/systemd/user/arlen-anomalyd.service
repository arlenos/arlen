[Unit]
Description=Arlen Anomaly Detector (user service)
Documentation=https://github.com/arlenos/anomaly-detector
# Reads the audit log (read API) and the Event Bus, and dispatches
# alerts via the notification daemon. All are best-effort dependencies:
# the detector retries and degrades rather than failing if any is
# absent, so `After=` only orders startup, it does not gate it.
After=arlen-auditd.service arlen-event-bus.service arlen-notifyd.service

[Service]
# Type=notify: the detector calls sd_notify(READY=1) once it is wired
# up and polling.
Type=notify
ExecStart=/usr/lib/arlen/libexec/arlen-anomalyd
Restart=on-failure
RestartSec=2

# The detector is a pure reader + notifier: it never writes the audit
# ledger or the graph. It needs only its own small state file and the
# runtime sockets, and never the network. Tight hardening accordingly.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/arlen
# NB the ordering above carries a second job that is not obvious from its purpose.
#
# `ReadWritePaths=/run/user/%U/arlen` below is FATAL when that directory does not
# exist yet, and nothing in this unit creates it: what makes it exist by the time
# this daemon starts is that auditd, the event bus or notifyd got there first. The
# undo signer had no such ordering and failed its first start on a booted image with
# "Failed at step NAMESPACE ... No such file or directory".
#
# So dropping a service from `After=` because this daemon no longer talks to it is a
# decision, not a tidy-up. If the list ever shrinks to nothing that creates the
# runtime directory, add `RuntimeDirectory=arlen` with `RuntimeDirectoryPreserve=yes`
# (the preserve flag is mandatory: the directory is shared, and systemd deletes an
# unpreserved one on stop, taking every other daemon's socket with it).
ReadWritePaths=/run/user/%U/arlen
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
