[Unit]
Description=Arlen timeline FUSE helper
Documentation=https://github.com/arlenos/knowledge
# The knowledge daemon binds the read socket this helper queries. After=, not
# Requires=: the timeline is optional and the helper's socket client retries, so
# a slow or absent daemon must never fail the boot.
After=arlen-graph.service

[Service]
Type=simple
ExecStart=/usr/bin/arlen-timeline
Restart=on-failure
RestartSec=2

# SUT system topology (matches arlen-graph's 10-system-sut.conf): the daemon's
# read socket on /run/arlen and the timeline mount under the StateDirectory, not
# the per-user ~/.timeline.
Environment=ARLEN_DAEMON_SOCKET=/run/user/%U/arlen/knowledge.sock
# Back to ~/.timeline, which is where the feature was designed to live and where
# a person looks for it. It moved to /var/lib/arlen/timeline when this was a
# SYSTEM unit and ProtectHome fenced the home directory off; as a user service
# mounting into its own home there is nothing to fence.
Environment=ARLEN_TIMELINE_MOUNT=%h/.timeline
# PIN THE BUS SOCKETS, because the default is now wrong for this unit. The SDK
# resolves an unset socket to `$XDG_RUNTIME_DIR/arlen/`, which is right for a user
# service - and the event bus is still a SYSTEM unit binding `/run/arlen/`. Left
# unset, the writer would dial a path nothing binds and retry forever, which is a
# knowledge graph that stays empty while every log line looks healthy.
#
# These come out when the bus moves per-user, which is the second half of this
# job; until then they are what makes the halves fit together.
# NO SOCKET PINS since 15 Aug: the bus is a per-user service, so the SDK's default
# of $XDG_RUNTIME_DIR/arlen/ is where it actually binds. These lines used to point
# at /run/arlen because the bus was a system unit, and a user service that did not
# pin them dialled a path nothing bound - silently, forever. Keeping them now would
# recreate that defect pointing the other way.

Environment=RUST_LOG=info

# This is the UNFENCED helper by design (same-uid-isolation-plan.md option b):
# the FUSE mount needs the SUID fusermount3, so NoNewPrivileges must stay false
# and /dev/fuse must be reachable - exactly what the main daemon's Landlock +
# no_new_privs write-fence cannot allow, which is why the mount lives here.
# Deliberately NO ProtectSystem / private mount namespace either: the daemon's
# in-process mount was invisible to the rest of the system under its hardening,
# whereas this helper shares the host mount namespace so the timeline actually
# propagates and is visible. The helper holds no write capability of its own
# beyond the mount point; it only reads the graph over the daemon's socket.
DeviceAllow=/dev/fuse rw

[Install]
WantedBy=default.target
