[Unit]
Description=Arlen App Store Backend (user service)
Documentation=https://github.com/arlenos/arlen
# The backend composes the merged catalog from local metadata and serves it over
# org.arlen.Store1. It reads only local files and binds one AF_UNIX socket, so it
# has no ordering dependency on any other daemon.

[Service]
Type=simple
# Production binary path (system-wide install). Dev runs invoke the debug binary
# directly; this file is the canonical production unit.
# The shared runtime directory is NOT this unit's to delete.
#
# systemd removes a `RuntimeDirectory=` when its unit stops, and `/run/user/%U/arlen`
# is shared: the consent broker, the undo signer, the notification daemon and the
# module runtime all bind their sockets inside it. Without this line, stopping this
# one service unlinks every one of those sockets while the daemons holding them are
# still running, and nothing can connect to them again until each restarts.
RuntimeDirectoryPreserve=yes
ExecStart=/usr/lib/arlen/libexec/arlen-store-backend
Restart=on-failure
RestartSec=2

# The backend reads local catalog metadata (read-only) and serves a read-only
# catalog over a same-user socket. It authenticates no peer (the catalog carries no
# per-user data), so the full mount-namespace hardening is safe here, unlike the
# peer-authenticating daemons that must keep /proc readable.
ProtectSystem=strict
ProtectHome=read-only
# The store socket lives under the per-user runtime dir.
RuntimeDirectory=arlen
ReadWritePaths=%t/arlen
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# No network today: the compose reads local files only, and the
# RestrictAddressFamilies line above is what enforces that - it is seccomp, so it
# holds in a user unit.
#
# This carried an `IPAddressDeny=any` as well until 15 Aug. That directive does
# nothing here: systemd applies IP firewalling by attaching BPF to the cgroup, and
# the per-user manager has no privileges for it. The boot says so once, for
# whichever unit tries first, and says nothing for any unit after it.
#
# The plan that stood here - relax to an `IPAddressAllow` of exactly the catalog
# hosts when the live fetchers land - does not work for the same reason, and
# RestrictAddressFamilies cannot express it either (it cannot tell one destination
# from another). Per-host egress for a user unit is the netns-plus-proxy enforcer
# in sdk/net-guard; that is what the fetchers will have to go through
# (store-app.md section 9.5 for the audit and no-identifier requirements).
UMask=0077

[Install]
WantedBy=default.target
