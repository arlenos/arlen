[D-BUS Service]
Name=org.arlen.Calendar1
Exec=/usr/lib/arlen/libexec/arlen-calendard
# Activation starts the unit, never the bare Exec above, so an activated calendar
# gets the same ordering and restart policy as one started at login. Without this
# line D-Bus would run the binary directly and quietly bypass both.
#
# The unit is eager (WantedBy=default.target) because a reminder has to be
# registered whether or not anyone opened the app, so this activation path is a
# fallback for a session where the unit has not started yet - not the normal way
# the calendar runs.
SystemdService=arlen-calendard.service
