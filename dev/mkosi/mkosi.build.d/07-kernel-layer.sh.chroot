#!/bin/sh
# The eBPF kernel layer: the sensor that produces `file.opened` and
# `process.started` from the kernel itself.
#
# WHY THIS PHASE DID NOT EXIST. Nothing built the kernel layer into any image -
# `grep kernel-layer dev/mkosi/mkosi.build.d/` came back empty on 15 Aug. So the
# graph's file and process picture has never come from the kernel on a booted
# system; what it holds comes from the dogfood driver and the shell. The daemon
# and its probes are written and now compile, and they ship nowhere.
#
# OFF UNLESS ASKED, and deliberately so. This phase needs a nightly toolchain
# (the eBPF target needs `-Z build-std=core`) and `bpf-linker`, which
# `cargo install` builds from source along with a large part of LLVM. Putting
# that in every image build would make every unrelated build pay for it, so it
# follows the verify-probe pattern: `ARLEN_KERNEL_LAYER=1` turns it on, a plain
# build runs this and does nothing.
#
# The flag is what gets removed once the cost is measured on a real run and the
# planner decides the sensor ships by default.
set -eu

if [ "${ARLEN_KERNEL_LAYER:-0}" != "1" ]; then
    echo ">> kernel layer not requested; skipping (set ARLEN_KERNEL_LAYER=1)"
    exit 0
fi

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-bpf"
PATH="$CARGO_HOME/bin:$PATH"
export PATH
mkdir -p "$RUSTUP_HOME" "$CARGO_HOME" "$CARGO_TARGET_DIR"

SRC="$SRCDIR/arlen/daemons/kernel-layer"

# The nightly toolchain the eBPF target needs. `rust-src` is not optional:
# `-Z build-std=core` compiles core from source for a target with no prebuilt std.
echo ">> kernel layer: nightly toolchain"
rustup toolchain install nightly --profile minimal --component rust-src

# NO `rustup target add bpfel-unknown-none` here, and its absence is the point.
# The target has no prebuilt std - rustup answers `has no prebuilt artifacts
# available`, which is what killed the first run of this phase - and that is
# precisely why the build passes `-Z build-std=core` and why `rust-src` is a
# required component above. core is compiled from source for this target; there is
# nothing to download.

# bpf-linker, which rustc invokes to produce the BPF object. Skipped when already
# cached, because this is the expensive half.
if [ ! -x "$CARGO_HOME/bin/bpf-linker" ]; then
    # bpf-linker links against a SPECIFIC LLVM major through llvm-sys, so the
    # version that installs depends on the LLVM in this image. Printing both
    # before trying means a mismatch names itself instead of arriving as
    # `could not find llvm-config`, which is how the first run failed - with no
    # LLVM present at all.
    echo ">> kernel layer: llvm-config reports $(llvm-config --version 2>/dev/null || echo ABSENT)"
    echo ">> kernel layer: building bpf-linker (slow, cached afterwards)"
    # PINNED TO THE IMAGE'S LLVM, from the third run's measurement rather than a
    # preference. `llvm-config` in this image reports 19.1.7 (trixie's LLVM), and
    # the unpinned latest bpf-linker builds against llvm-sys 231 - LLVM 21 - so it
    # got as far as linking and died on `unable to find library -lLLVM`.
    #
    # 0.9.13 is the line that links against LLVM 19. If this pin is wrong the
    # build says so immediately and loudly, which is why the version printed above
    # sits right next to it: the two have to agree, and both are visible in the
    # same three lines of log.
    cargo install bpf-linker --locked --version 0.9.13
fi

# The eBPF program first: the userspace daemon embeds the object, so the object
# has to exist before the daemon compiles. RELEASE because that is the path the
# daemon's build.rs looks for, and because a debug BPF object routinely exceeds
# the verifier's instruction limit.
echo ">> kernel layer: building the eBPF program"
cargo +nightly build --release \
    --manifest-path "$SRC/Cargo.toml" \
    -p kernel-layer-ebpf \
    --target bpfel-unknown-none \
    -Z build-std=core

echo ">> kernel layer: building the userspace daemon"
cargo build --release --manifest-path "$SRC/Cargo.toml" -p kernel-layer

install -Dm755 "$CARGO_TARGET_DIR/release/kernel-layer" \
        "$DESTDIR/usr/bin/arlen-kernel-layer"

# The unit, from the crate's own `dist/` like every other daemon's. It was a
# heredoc here until 18 August, which kept it out of `check-shipped-units`
# entirely: that gate takes its subjects from `daemons/*/dist/**`, so a unit
# written inline was not a subject and could not be checked against the image.
# The sensor whose absence the gate was written to catch was the one unit it
# could not see.
#
# It runs as root under the SYSTEM manager, and both halves are load-bearing:
# loading a BPF program and attaching a tracepoint need CAP_BPF and CAP_PERFMON,
# and the sensor observes the whole machine rather than one session.
install -Dm644 "$SRC/dist/arlen-kernel-layer.service" \
        "$DESTDIR/usr/lib/systemd/system/arlen-kernel-layer.service"

# The enable, HERE rather than in `mkosi.extra`, because the unit only exists
# when this phase ran. Every other system unit on the image is enabled by a
# symlink checked into `mkosi.extra/etc/systemd/system/multi-user.target.wants/`,
# and one for a conditional unit would dangle on every plain build.
#
# It is needed at all - `[Install] WantedBy=` on its own enables nothing. The
# unit shipped without this and `check-image-contents` said so the moment the
# unit became visible to it: a binary on the image and nothing that starts it,
# which is the sensor present and silent, indistinguishable on a running desktop
# from the sensor absent.
mkdir -p "$DESTDIR/usr/lib/systemd/system/multi-user.target.wants"
ln -sf ../arlen-kernel-layer.service \
       "$DESTDIR/usr/lib/systemd/system/multi-user.target.wants/arlen-kernel-layer.service"

echo ">> staged the kernel layer into the image"
