#!/bin/sh
# Phase 3 of the Debian-native build (CHROOT): the compositor (cosmic-comp, a
# Smithay-based Wayland compositor) - ranked hard part, it must drive the VM's
# virtio-gpu under software GL (llvmpipe). Links the Debian Mesa/Wayland/libinput/
# libseat/libdisplay-info system libs, so it builds here, not via cargo-zigbuild.
# The compositor repo is mounted at $SRCDIR/compositor (BuildSources). rustup was
# installed by phase 2 into the shared cache.
#
# ITS TWO ARLEN DEPENDENCIES COME FROM THE MOUNTED TREE, not from github. The
# compositor git-deps `arlen-theme` and `arlen-permissions` on the monorepo, and
# with an empty cargo home (the build dir does not survive between builds on this
# machine) that meant cloning the whole monorepo - 1.1 GB of history - for two
# small crates. On 8 October it sat on `Updating git repository` for half an hour
# at 130 KiB/s. The monorepo is already mounted at $SRCDIR/arlen, and building
# against it is also the more honest image: the compositor links the same theme
# and permissions code as every other component in it, local commits included,
# rather than whatever was last pushed.
#
# Built from a COPY of the compositor source. The patch rewrites Cargo.lock, and
# BuildSources is a read-write bind mount, so building in place would have edited
# the compositor repository's real lockfile on the host.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-compositor"   # separate from the arlen workspace
mkdir -p "$CARGO_TARGET_DIR"

# Phase 2 installs rustup; ensure it (idempotent) in case phase ordering changes.
if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

src="$cache/compositor-src"
rm -rf "$src"
mkdir -p "$src"
# Everything but build output: the repo's own target/ can be gigabytes.
tar -C "$SRCDIR/compositor" --exclude=./target --exclude=./.git -cf - . | tar -C "$src" -xf -
cd "$src"
arlen="https://github.com/arlenos/arlen"
theme="$SRCDIR/arlen/sdk/theme"
permissions="$SRCDIR/arlen/sdk/permissions"
echo ">> cargo build cosmic-comp - Debian-native ($(cargo --version)), arlen crates from the mounted tree"
cargo build --release --bin cosmic-comp \
    --config "patch.\"$arlen\".arlen-theme.path=\"$theme\"" \
    --config "patch.\"$arlen\".arlen-permissions.path=\"$permissions\""
# Installed as `arlen-compositor`, not under the upstream fork's name, and this
# is a security property rather than tidiness. `detect_tier` places a binary by
# path prefix - /usr/bin/arlen- or /usr/lib/arlen/ - so `/usr/bin/cosmic-comp`
# resolved to nothing, and a 12 Aug boot journal caught the consequence:
# `publish would be denied (shadow mode) app_id="<unresolved>"
# event_type=window.focus_left`. An unresolvable core component means the enforce
# switch can never be flipped at all, which is worse than the question it defers.
# The crate and its `--bin` keep the upstream name; only the installed path moves.
install -Dm755 "$CARGO_TARGET_DIR/release/cosmic-comp" "$DESTDIR/usr/bin/arlen-compositor"
echo ">> staged the compositor into the image as arlen-compositor"

# The stale-frame repro. It has to run against the KMS backend, because the nested
# X11 backend repaints both unmap paths correctly and cannot show the bug, so it
# has to be inside the image rather than on the host. It is a client that vacates
# its own region on a timer and needs no input injection, which is what makes it
# usable in a VM at all.
#
# ARLEN_IMAGE_TOOLS=0 leaves it out. This is the verification image; a release
# image should not carry it.
if [ "${ARLEN_IMAGE_TOOLS:-1}" != "0" ]; then
    cargo build --release --features test-client --bin ghost-repro
    install -Dm755 "$CARGO_TARGET_DIR/release/ghost-repro" "$DESTDIR/usr/bin/ghost-repro"
    echo ">> staged ghost-repro into the image"
fi
