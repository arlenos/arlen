#!/bin/sh
# Phase 4o of the Debian-native build (CHROOT): the Settings app (arlen-settings,
# a Tauri 2 app), the same two-step as its neighbours - the SvelteKit frontend,
# then the Tauri Rust backend.
#
# WHY IT WAS ABSENT. Seventy-two Svelte files, the most mature surface in the
# tree, and nothing under `dev/mkosi/` built it: a booted image had no way to
# change a wallpaper, a display layout, a sound, a permission or an AI switch.
# The surfaces it drives were all on the image - the config broker, the
# permission helper, the display daemon - with nothing in front of them.
#
# It is also a PRINCIPAL, not just a window. `installd`'s INSTALL_CALLERS, the
# config broker's admitted writers and the knowledge daemon's revoke caller each
# name `dev.arlen.settings`, and `path_to_app_id` resolves it from exactly the
# path installed below. Staging it anywhere else would resolve to a different id
# and quietly refuse all three.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-settings"  # own dir; separate workspace
export CXXFLAGS="-include cstdint"
export LIBGL_ALWAYS_SOFTWARE=1
export npm_config_cache="$cache/npm"
mkdir -p "$CARGO_TARGET_DIR" "$npm_config_cache"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen/apps/settings"
if [ -x ./node_modules/.bin/tauri ] && [ ! package-lock.json -nt node_modules ]; then
    echo ">> node_modules is complete and current; skipping npm ci"
else
    echo ">> npm ci (frontend + tauri-cli deps)"
    npm ci --no-audit --no-fund --loglevel=error
fi

echo ">> tauri build --no-bundle (production) arlen-settings"
./node_modules/.bin/tauri build --no-bundle

out=$(find "$CARGO_TARGET_DIR" -type f -path '*/release/arlen-settings' 2>/dev/null \
        | head -1)
[ -n "$out" ] || { echo "!! arlen-settings not found after build" >&2; exit 1; }

# The path is load-bearing: `path_to_app_id` matches
# `/usr/lib/arlen/apps/dev.arlen.settings/bin/arlen-settings` by strict equality
# and answers `dev.arlen.settings`. The `/usr/bin` symlink is for the shell and
# for `arlen-settings --panel ...`; identity is resolved from the real path
# behind it, so the link cannot mint a second name.
install -Dm755 "$out" \
        "$DESTDIR/usr/lib/arlen/apps/dev.arlen.settings/bin/arlen-settings"
mkdir -p "$DESTDIR/usr/bin"
ln -sf "../lib/arlen/apps/dev.arlen.settings/bin/arlen-settings" \
        "$DESTDIR/usr/bin/arlen-settings"
install -Dm644 "$SRCDIR/arlen/apps/settings/dist/arlen-settings.desktop" \
        "$DESTDIR/usr/share/applications/arlen-settings.desktop"
install -Dm644 "$SRCDIR/arlen/apps/settings/src-tauri/icons/128x128.png" \
        "$DESTDIR/usr/share/icons/hicolor/128x128/apps/arlen-settings.png"
echo ">> staged arlen-settings into the image"
