#!/bin/sh
# Phase 4n of the Debian-native build (CHROOT): the document reader (arlen-pdf, a
# Tauri 2 app), the same two-step as its neighbours - the SvelteKit frontend, then
# the Tauri Rust backend.
#
# WHY IT WAS ABSENT. The reader was built, its decode worker was built, and nothing
# ever put it on a machine: no build step, no desktop entry, no MIME claim. So the
# image could not open a PDF at all - not from the file manager, not from a mail
# attachment, not from the command line - while the app that does it sat finished in
# the tree. The neighbouring apps each carry these three lines; this one did not.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-pdf"  # own dir; separate workspace
export CXXFLAGS="-include cstdint"
export LIBGL_ALWAYS_SOFTWARE=1
export npm_config_cache="$cache/npm"
mkdir -p "$CARGO_TARGET_DIR" "$npm_config_cache"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen/apps/pdf"
if [ -x ./node_modules/.bin/tauri ] && [ ! package-lock.json -nt node_modules ]; then
    echo ">> node_modules is complete and current; skipping npm ci"
else
    echo ">> npm ci (frontend + tauri-cli deps)"
    npm ci --no-audit --no-fund --loglevel=error
fi

# NOT BUILT HERE, and named so the gap is visible: `apps/pdf/decode-page` is a
# second binary (`arlen-pdf-decode-page`) that draws one page in a sandboxed
# process. It links `pdfium-render`, and there is no libpdfium in this image, so
# building it would fail the whole image build to ship something that could not
# run. Without it the reader opens a document, lists its contents, searches inside
# it and shows each page as text - which is why the reader is here at all. When a
# rasteriser is settled, this step gains the worker beside the app binary: the app
# looks for it next to its own executable (`worker_dir`), and answers `no-renderer`
# until it is there.
echo ">> tauri build --no-bundle (production) arlen-pdf"
./node_modules/.bin/tauri build --no-bundle

# THE CRATE IS `arlen-pdf-app` AND THE INSTALLED BINARY IS `arlen-pdf`, which is
# the whole trap this line fell into. `tauri build --no-bundle` produces the cargo
# artefact and nothing renames it: `productName` in tauri.conf.json only names a
# BUNDLE, which this build does not make. Searching for the installed name found
# nothing and failed the phase, and with it the whole image. The sibling calendar
# step has the same crate-vs-installed split and gets it right.
out=$(find "$CARGO_TARGET_DIR" -type f -path '*/release/arlen-pdf-app' 2>/dev/null \
        | head -1)
[ -n "$out" ] || { echo "!! arlen-pdf-app not found after build" >&2; exit 1; }

install -Dm755 "$out" \
        "$DESTDIR/usr/lib/arlen/apps/dev.arlen.pdf/bin/arlen-pdf"
mkdir -p "$DESTDIR/usr/bin"
ln -sf "../lib/arlen/apps/dev.arlen.pdf/bin/arlen-pdf" \
        "$DESTDIR/usr/bin/arlen-pdf"
install -Dm644 "$SRCDIR/arlen/apps/pdf/dist/arlen-pdf.desktop" \
        "$DESTDIR/usr/share/applications/arlen-pdf.desktop"
install -Dm644 "$SRCDIR/arlen/apps/pdf/src-tauri/icons/128x128.png" \
        "$DESTDIR/usr/share/icons/hicolor/128x128/apps/arlen-pdf.png"
echo ">> staged arlen-pdf into the image"
