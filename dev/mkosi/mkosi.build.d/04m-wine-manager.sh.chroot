#!/bin/sh
# Phase 4m (CHROOT): the Wine manager (arlen-wine-manager, a Tauri 2 app). Same two-step as
# the other apps: build the SvelteKit frontend (vite -> ../build, the tauri
# frontendDist), then the Tauri Rust backend, which embeds it.
#
# IT SHOWS BOTTLES AND DOES NOT YET MAKE THEM. A bottle is a Wine prefix cut
# loose from the home directory - no `Z:` mapping the filesystem, no shell folders
# pointing at the real Documents - reaching only the folders it was granted, each
# one a drive letter. `arlen-wine-core` makes them, cuts them, writes their drive
# table and launches into them, and this window reads what is there and says what
# each one may reach. Making and launching from the window come with the bottle
# daemon.
#
# STAGED ANYWAY, because the reading half is the half a person needs first: a
# machine that has bottles and no way to see what they reach is worse than one
# with neither. And `wine` is NOT on the image (`runtime-deps.tsv` records that,
# with what it costs), so the window will show an empty list until the
# distribution decides to ship it, which is a decision on the record rather than
# a surprise at spawn.
#
# The install path is load-bearing: `/usr/lib/arlen/apps/dev.arlen.wine-manager/` is what
# the resolver maps to the app id, which is what a daemon's caller gate will
# admit. Installed elsewhere the app still runs and the gate refuses it, so this
# line and `X-Arlen-AppId=dev.arlen.wine-manager` in the desktop entry have to keep
# saying the same thing.
#
# rustup + node + the -dev libs were installed by phases 1-2; network is on via
# WithNetwork=yes.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-wine-manager-app"  # own dir; app is a separate workspace
export CXXFLAGS="-include cstdint"
export LIBGL_ALWAYS_SOFTWARE=1                     # llvmpipe, harmless at build time
export npm_config_cache="$cache/npm"               # persist the npm cache across builds
mkdir -p "$CARGO_TARGET_DIR" "$npm_config_cache"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen/apps/wine-manager"
# Reuse a complete + current node_modules instead of re-running npm ci (the chroot
# overlay's per-file fchown EINVAL makes a fresh npm ci pathologically slow); the
# repo is bind-mounted via BuildSources, so a host-prepared node_modules is visible
# here. Fall back to a quieted npm ci with the audit/fund round-trips skipped.
if [ -x ./node_modules/.bin/tauri ] && [ ! package-lock.json -nt node_modules ]; then
    echo ">> node_modules is complete and current; skipping npm ci"
else
    echo ">> npm ci (frontend + tauri-cli deps)"
    npm ci --no-audit --no-fund --loglevel=error
fi

# Production build, not a plain cargo build: a debug build leaves the webview
# pointed at the dev URL, so the packaged app would show a connection-refused page
# instead of the agenda. --no-bundle: we want the binary, not a .deb/AppImage.
echo ">> tauri build --no-bundle (production) arlen-wine-manager"
./node_modules/.bin/tauri build --no-bundle

# The crate is `arlen-wine-manager-app`, so that is what cargo emits; the image installs
# it as `arlen-wine-manager`, which is what the desktop entry's Exec names. Searching
# for the INSTALLED name rather than the crate name is what failed the whole image
# build when the clock step was written; the same trap is here verbatim.
out=$(find "$CARGO_TARGET_DIR" -type f -path '*/release/arlen-wine-manager-app' 2>/dev/null \
        | head -1)
[ -n "$out" ] || { echo "!! arlen-wine-manager-app not found after build" >&2; exit 1; }
# The app lives under its own id, which is what makes the id: the resolver's
# rule (3) reads the directory name below `/usr/lib/arlen/apps/`, so an app
# installed to `/usr/bin/` took rule (2) - the system-daemon rule - and resolved
# to the bare basename instead. The `/usr/bin` symlink keeps `Exec=` and PATH
# working; `/proc/<pid>/exe` resolves through it to the real path, so identity
# comes from the app directory either way.
install -Dm755 "$out" "$DESTDIR/usr/lib/arlen/apps/dev.arlen.wine-manager/bin/arlen-wine-manager"
mkdir -p "$DESTDIR/usr/bin"
ln -sf "../lib/arlen/apps/dev.arlen.wine-manager/bin/arlen-wine-manager" "$DESTDIR/usr/bin/arlen-wine-manager"
# The launcher enumerates /usr/share/applications; without an entry there the app
# is installed and undiscoverable, which reads as a broken launcher rather than a
# missing file. The entry and the icon live with the app, so they are staged by
# the same step that stages the binary and cannot drift from it.
install -Dm644 "$SRCDIR/arlen/apps/wine-manager/dist/arlen-wine-manager.desktop" \
        "$DESTDIR/usr/share/applications/arlen-wine-manager.desktop"
install -Dm644 "$SRCDIR/arlen/apps/wine-manager/src-tauri/icons/128x128.png" \
        "$DESTDIR/usr/share/icons/hicolor/128x128/apps/arlen-wine-manager.png"
echo ">> staged arlen-wine-manager into the image"
