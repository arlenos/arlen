#!/bin/sh
# Phase 8w (CHROOT): the calendar daemon (arlen-calendard). It owns
# `org.arlen.Calendar1` on the session bus, reads the `.ics` files under
# `$XDG_DATA_HOME/arlen/calendars`, and registers each upcoming occurrence's
# trigger with the clock so a reminder still fires with the window shut. That
# last clause is the whole reason the app is worth having, and until this step it
# was unreachable on a real install.
#
# STAGED WITH THE APP, phase 4k, and neither was staged before. A reminder daemon
# on an image where nothing writes `.ics` is a process that reliably finds
# nothing - the class we spent a week deleting - so it waited for a way in. The
# app now keeps an opened invitation into the calendar directory, which is that
# way in: no sync service, no importer and no editor, but a real machine can gain
# a real calendar and this daemon then has something to ring.
#
# The binary path is the canonical `path_to_app_id` entry that resolves this
# daemon to `calendard`, which is the id its permission profile is named for
# (`mkosi.extra/var/lib/arlen/permissions/1000/calendard.toml`) and the id the
# clock's caller gate will admit when it registers a wake. Installed anywhere
# else it still runs and cannot arm anything.
#
# Its own standalone cargo workspace (daemons/calendar) -> its own target dir in
# the persistent cache. Pure Rust, no C/C++.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-calendar"
mkdir -p "$RUSTUP_HOME" "$CARGO_HOME" "$CARGO_TARGET_DIR"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    echo ">> bootstrapping rustup stable into the build cache"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen"   # the repo root, mounted via BuildSources=../../:arlen
echo ">> cargo build the calendar daemon (arlen-calendard) - Debian-native ($(cargo --version))"
cargo build --release --manifest-path daemons/calendar/Cargo.toml --bin arlen-calendard

install -Dm755 "$CARGO_TARGET_DIR/release/arlen-calendard" \
    "$DESTDIR/usr/lib/arlen/libexec/arlen-calendard"

# The permission profile is NOT installed from here. Profiles are read from the
# system tier, /var/lib/arlen/permissions/<uid>/, and the image ships those as
# static extras beside its siblings - so the calendar's lives at
# mkosi.extra/var/lib/arlen/permissions/1000/calendard.toml. Putting a copy under
# /usr/share would place it where nothing looks, which is the exact shape of
# failure this whole packaging step exists to prevent.
echo ">> staged arlen-calendard into the image"
