#!/bin/sh
# Phase 8x (CHROOT): the Windows-app runtime (arlen-bottled). It holds the
# capability-scoped Wine prefixes - the drive table a bottle's grants become, the
# prefix check, and the launch that puts a Windows program inside one - and serves
# them over a socket the Settings "Windows apps" panel reads.
#
# A DAEMON RATHER THAN A LIBRARY the Settings backend links, which is the whole
# reason this phase exists: a launched Windows program has to outlive the window
# that started it (`windows-apps-plan.md`). The panel that used to be an app is
# retired; this is where its runtime went.
#
# Resolves as a standalone package (cargo build --manifest-path) -> its own target
# dir in the persistent cache. Pure Rust, no C/C++.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-bottled"
mkdir -p "$RUSTUP_HOME" "$CARGO_HOME" "$CARGO_TARGET_DIR"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    echo ">> bootstrapping rustup stable into the build cache"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen"   # the repo root, mounted via BuildSources=../../:arlen
echo ">> cargo build the Windows-app runtime (arlen-bottled) - Debian-native ($(cargo --version))"
cargo build --release --manifest-path daemons/bottled/Cargo.toml

install -Dm755 "$CARGO_TARGET_DIR/release/arlen-bottled" \
    "$DESTDIR/usr/lib/arlen/libexec/arlen-bottled"
echo ">> staged arlen-bottled into the image"
