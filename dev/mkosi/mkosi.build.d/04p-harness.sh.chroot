#!/bin/sh
# Phase 4p of the Debian-native build (CHROOT): the assistant harness
# (arlen-harness, a Tauri 2 app), the same two-step as its neighbours - the
# SvelteKit frontend, then the Tauri Rust backend.
#
# WHY IT WAS ABSENT. Forty-five Svelte files, the whole AI surface - the
# conversation, the pending-proposal feed, the transparency drawer and the undo
# panel - and nothing under `dev/mkosi/` built it. The daemons it talks to are all
# on the image; the window that talks to them was not.
#
# It is also the target of a spawn: the terminal's share-a-block entry writes a
# 0600 payload and launches `arlen-harness --inject <path>`, which reported
# `No such file or directory` on every image until this step existed. That is
# why `check-spawned-binaries` carried it as a known absence.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-harness"  # own dir; separate workspace
export CXXFLAGS="-include cstdint"
export LIBGL_ALWAYS_SOFTWARE=1
export npm_config_cache="$cache/npm"
mkdir -p "$CARGO_TARGET_DIR" "$npm_config_cache"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen/apps/harness"
if [ -x ./node_modules/.bin/tauri ] && [ ! package-lock.json -nt node_modules ]; then
    echo ">> node_modules is complete and current; skipping npm ci"
else
    echo ">> npm ci (frontend + tauri-cli deps)"
    npm ci --no-audit --no-fund --loglevel=error
fi

echo ">> tauri build --no-bundle (production) arlen-harness"
./node_modules/.bin/tauri build --no-bundle

out=$(find "$CARGO_TARGET_DIR" -type f -path '*/release/arlen-harness' 2>/dev/null \
        | head -1)
[ -n "$out" ] || { echo "!! arlen-harness not found after build" >&2; exit 1; }

# `/usr/lib/arlen/apps/dev.arlen.harness/bin/` because rule 3 of `path_to_app_id`
# reads the app id off that directory name, and `dev.arlen.harness` is what the
# shipped permission profile is filed under and one of the three compiled-in user
# surfaces. The `/usr/bin` symlink is what the terminal's `Command::new` finds on
# PATH; identity is still resolved from the real path behind it.
install -Dm755 "$out" \
        "$DESTDIR/usr/lib/arlen/apps/dev.arlen.harness/bin/arlen-harness"
mkdir -p "$DESTDIR/usr/bin"
ln -sf "../lib/arlen/apps/dev.arlen.harness/bin/arlen-harness" \
        "$DESTDIR/usr/bin/arlen-harness"
install -Dm644 "$SRCDIR/arlen/apps/harness/dist/arlen-harness.desktop" \
        "$DESTDIR/usr/share/applications/arlen-harness.desktop"
install -Dm644 "$SRCDIR/arlen/apps/harness/src-tauri/icons/128x128.png" \
        "$DESTDIR/usr/share/icons/hicolor/128x128/apps/arlen-harness.png"
echo ">> staged arlen-harness into the image"
