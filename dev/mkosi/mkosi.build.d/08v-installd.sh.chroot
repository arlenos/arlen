#!/bin/sh
# Phase 8v (CHROOT): the install path - `installd` and its two root helpers.
#
# WHAT THIS UNBLOCKS. Settings dials `org.arlen.InstallDaemon1` today and, when
# nothing answers, tells the user that removing an application is unavailable.
# It was telling the truth: none of the three binaries was on the image. An
# operating system you cannot remove an application from is not a daily driver,
# so the surface was honest about a system that was incomplete.
#
# THREE PARTS AND TWO BUSES. `installd` is a USER service (`WantedBy=default.target`)
# that owns `org.arlen.InstallDaemon1` on the session bus; `install-helper` and
# `permission-helper` are SYSTEM services running as root, so their units go under
# `systemd/system` and their D-Bus policy under `system.d`. Installing a
# root-privileged helper's unit in the user directory would leave it never started
# and the daemon refused at every privileged step.
#
# WHAT IS DELIBERATELY NOT HERE: `arlen-trash-cleanup.service` and its timer. They
# ship in the same `dist/` and are easy to sweep in by globbing the directory, so
# each file below is named individually. The cleanup deletes user data on a timer,
# and trash now spans every mounted volume, which puts removable media inside its
# retention rule. That is a decision to take awake, and the planner has kept it
# deferred on exactly those grounds.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-installd"   # own dir; separate workspace
mkdir -p "$RUSTUP_HOME" "$CARGO_HOME" "$CARGO_TARGET_DIR"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    echo ">> bootstrapping rustup stable into the build cache"
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

src="$SRCDIR/arlen/daemons/installd"

cd "$SRCDIR/arlen"
echo ">> cargo build the install path - Debian-native ($(cargo --version))"
cargo build --release --manifest-path "$src/Cargo.toml"

# The install destinations are the units' own `ExecStart=` lines and not a
# convention: `permission-helper` sits directly under `/usr/lib/arlen/` while the
# other two are in `libexec/`. That inconsistency is real and is left alone here -
# staging a binary somewhere the unit does not look is how a service ends up
# installed and permanently failing to start.
for pair in \
    "arlen-installd:/usr/lib/arlen/libexec/arlen-installd" \
    "arlen-install-helper:/usr/lib/arlen/libexec/arlen-install-helper" \
    "arlen-permission-helper:/usr/lib/arlen/permission-helper"
do
    bin="${pair%%:*}"
    dest="${pair##*:}"
    out="$CARGO_TARGET_DIR/release/$bin"
    [ -x "$out" ] || { echo "!! $bin not found after build" >&2; exit 1; }
    install -Dm755 "$out" "$DESTDIR$dest"
done

# The user service (session bus) and its activation file.
install -Dm644 "$src/dist/installd.service" \
        "$DESTDIR/usr/lib/systemd/user/installd.service"
install -Dm644 "$src/dist/org.arlen.InstallDaemon1.service" \
        "$DESTDIR/usr/share/dbus-1/services/org.arlen.InstallDaemon1.service"

# The two root helpers: system units, system-bus activation, and the bus policy
# that decides who may call them. The policy is the part that must not be
# forgotten - without it the system bus refuses every method and the helpers are
# present but unreachable, which looks identical to not shipping them.
install -Dm644 "$src/dist/install-helper.service" \
        "$DESTDIR/usr/lib/systemd/system/install-helper.service"
install -Dm644 "$src/dist/permission-helper.service" \
        "$DESTDIR/usr/lib/systemd/system/permission-helper.service"
install -Dm644 "$src/dist/org.arlen.InstallHelper1.service" \
        "$DESTDIR/usr/share/dbus-1/system-services/org.arlen.InstallHelper1.service"
install -Dm644 "$src/dist/org.arlen.PermissionHelper1.service" \
        "$DESTDIR/usr/share/dbus-1/system-services/org.arlen.PermissionHelper1.service"
install -Dm644 "$src/dist/org.arlen.InstallHelper1.conf" \
        "$DESTDIR/usr/share/dbus-1/system.d/org.arlen.InstallHelper1.conf"
install -Dm644 "$src/dist/org.arlen.PermissionHelper1.conf" \
        "$DESTDIR/usr/share/dbus-1/system.d/org.arlen.PermissionHelper1.conf"

echo ">> staged installd, its two root helpers, and their bus policy"
