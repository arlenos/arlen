#!/bin/sh
# Phase 4j of the Debian-native build (CHROOT): the screenshot app (arlen-screenshot,
# a Tauri 2 app), same two-step as the files app (04c).
#
# VERIFIED CAPTURING BEFORE IT WAS STAGED, and the way it was verified is the point.
# This app needs a live compositor advertising wlr-screencopy, so a plain Xvfb harness
# can only ever show its fallback. Run instead against the NESTED compositor
# (`dev/screenshot/shoot-compositor.sh`) it captures for real: the shot comes back
# recursive, the app window showing a preview of the screen that contains the app
# window. That is a compositor belonging to the test and not to whoever ran it, which
# is the only honest way to test a tool that photographs screens.
set -eu

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-screenshot"  # own dir; separate workspace
export CXXFLAGS="-include cstdint"
export LIBGL_ALWAYS_SOFTWARE=1
export npm_config_cache="$cache/npm"
mkdir -p "$CARGO_TARGET_DIR" "$npm_config_cache"

if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
fi
export PATH="$CARGO_HOME/bin:$PATH"

cd "$SRCDIR/arlen/apps/screenshot"
if [ -x ./node_modules/.bin/tauri ] && [ ! package-lock.json -nt node_modules ]; then
    echo ">> node_modules is complete and current; skipping npm ci"
else
    echo ">> npm ci (frontend + tauri-cli deps)"
    npm ci --no-audit --no-fund --loglevel=error
fi

echo ">> tauri build --no-bundle (production) arlen-screenshot"
./node_modules/.bin/tauri build --no-bundle

out=$(find "$CARGO_TARGET_DIR" -type f -path '*/release/arlen-screenshot' 2>/dev/null \
        | head -1)
[ -n "$out" ] || { echo "!! arlen-screenshot not found after build" >&2; exit 1; }

install -Dm755 "$out" \
        "$DESTDIR/usr/lib/arlen/apps/dev.arlen.screenshot/bin/arlen-screenshot"
mkdir -p "$DESTDIR/usr/bin"
ln -sf "../lib/arlen/apps/dev.arlen.screenshot/bin/arlen-screenshot" \
        "$DESTDIR/usr/bin/arlen-screenshot"
install -Dm644 "$SRCDIR/arlen/apps/screenshot/dist/arlen-screenshot.desktop" \
        "$DESTDIR/usr/share/applications/arlen-screenshot.desktop"
install -Dm644 "$SRCDIR/arlen/apps/screenshot/src-tauri/icons/128x128.png" \
        "$DESTDIR/usr/share/icons/hicolor/128x128/apps/arlen-screenshot.png"
echo ">> staged arlen-screenshot into the image"
