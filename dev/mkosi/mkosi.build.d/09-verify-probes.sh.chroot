#!/bin/sh
# Phase 9 (CHROOT): the verify-only probes.
#
# THE ONE RULE THIS FILE EXISTS TO KEEP: the verify image is the release image
# PLUS these binaries, never minus anything. A verify variant that can differ by
# OMISSION verifies a different system than the one that ships, which is the
# mechanism-versus-assembly gap one level up - and this week has already spent
# three findings on that gap.
#
# So the branch lives HERE and nowhere else. No release phase may ask whether this
# is a verify build; `check-verify-image.sh` fails the tree if one does, if a
# verify phase writes a path a release phase also writes, or if it removes
# anything. Under those three, "plus, never minus" holds by construction rather
# than by anyone remembering it.
#
# Off unless asked: `dev/mkosi/build-image.sh --verify` passes the flag through
# `mkosi -E`. A plain build runs this phase and it does nothing.
set -eu

if [ "${ARLEN_VERIFY_IMAGE:-0}" != "1" ]; then
    echo ">> not a verify image; no probes staged"
    exit 0
fi

cache="${BUILDDIR:-/var/tmp/arlen-build}"
export RUSTUP_HOME="$cache/rustup"
export CARGO_HOME="$cache/cargo-home"
export CARGO_TARGET_DIR="$cache/target-verify-probes"
mkdir -p "$CARGO_TARGET_DIR"
export PATH="$CARGO_HOME/bin:$PATH"

echo ">> building the verify probes"
cargo build --release --manifest-path "$SRCDIR/arlen/dev/kg-probe/Cargo.toml"

# `/usr/bin`, because a probe is run by hand over a serial console and having to
# remember a libexec path defeats the point of having it.
install -Dm755 "$CARGO_TARGET_DIR/release/arlen-kg-probe" \
        "$DESTDIR/usr/bin/arlen-kg-probe"

# Run it once at boot, as root, and put the answer on the serial console.
#
# Two reasons it is a unit and not the session hook. First, there is no shell into
# this VM - the harness speaks QMP, so anything I want to read has to arrive in the
# journal or on the console by itself. Second, and this is the part I got wrong the
# first time: run from the session the probe is uid 1000 with a THIRD-PARTY id, and
# `cross_uid_admitted` refuses it before the owner check is even reached. That
# refusal is the gate working, and it made the probe's six questions all report
# "Broken pipe" while saying nothing about the graph.
#
# As root the probe is the daemon's own uid, so no cross-uid rule applies and the
# question it answers is "what does the graph hold". That is NOT the same question
# as "what does the app see" - an app is uid 1000 with a first-party id and passes
# a different pair of checks. Anyone reading this output for the second question
# will get a confident wrong answer, which is why it is written down here.
# Written straight to its final path. The obvious shape - heredoc to /tmp, install,
# delete the temp - trips check (3), which fails any verify phase that runs `rm`.
# The check is right to: it cannot tell a temp-file cleanup from a phase quietly
# deleting release content, and "plus, never minus" is worth more than the
# convenience. Writing the file where it belongs needs no cleanup at all.
mkdir -p "$DESTDIR/usr/lib/systemd/system"
cat > "$DESTDIR/usr/lib/systemd/system/arlen-kg-probe.service" <<'UNIT'
[Unit]
Description=Ask the knowledge graph what it holds (verify image only)
After=arlen-graph.service
Wants=arlen-graph.service

[Service]
Type=oneshot
RemainAfterExit=yes
# No User=, so root. The reasoning is at the top of this file; what was missing
# was the evidence, so here it is. Tried as `User=arlen` on 12 Aug because an app
# is a user process: every question came back `Connection reset by peer` and the
# daemon logged `rejecting untrusted cross-uid client peer_uid=1000
# app_id=kg-probe`. The tier in `cross_uid_admitted` comes from the hardcoded
# `QuotaConfig::arlen_default()` table, not from the `tier` field in the profile
# below, and `kg-probe` must not be added to that table - it is release policy and
# this binary is on no release image.

# The probe now asks twice with a gap, so it outlives systemd's default 90s start
# timeout. Nothing waits on this unit, so a generous ceiling costs nothing and a
# killed probe would look exactly like a probe that found nothing.
TimeoutStartSec=300
# Wait for the socket, but never longer than a minute, and run either way: a probe
# that stays silent because it gave up is worse than one that reports it could not
# connect. The daemon binds late enough that connecting immediately loses the race.
#
# No shell variable in here, deliberately. systemd expands $NAME in Exec lines
# ITSELF, so the obvious counter loop arrives at /bin/sh as `[ -lt 60 ]` and dies
# on a syntax error - and because a failing ExecStartPre skips ExecStart, the
# symptom would have been the probe silently never running. `timeout` needs no
# counter, and the leading `-` tells systemd to run ExecStart even when the wait
# expires.
ExecStartPre=-/usr/bin/timeout 60 /bin/sh -c 'while [ ! -S /run/arlen/knowledge.sock ]; do sleep 1; done'
ExecStart=/usr/bin/arlen-kg-probe
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
UNIT
chmod 644 "$DESTDIR/usr/lib/systemd/system/arlen-kg-probe.service"

# And a read scope, or the probe asks and is refused.
#
# Running as root got it past the cross-uid rule; the read-scope label gate then
# denied all six questions, because `kg-probe` has no profile and an absent
# profile means an empty scope. Right on both counts - that is the gate doing its
# job - but a probe that can only report "denied" cannot answer what the graph
# holds.
#
# The grant is EXACTLY the knowledge app's read list, because the probe's whole
# purpose is to ask the app's questions from outside the app. A wider scope would
# let the probe report rows the app could never see, which is a worse failure than
# no probe at all: it would look like an answer.
#
# Verify-only, and it has to stay that way. This file is written by this phase
# into $DESTDIR; it does NOT go in `mkosi.extra/var/lib/arlen/permissions/`, where
# the app profiles live, because everything there ships in every image and a
# release system has no `kg-probe` to grant anything to.
# Under 0/, not 1000/: the daemon resolves a profile by the PEER uid, and the
# peer here is root. See the User= reasoning in the unit above.
mkdir -p "$DESTDIR/var/lib/arlen/permissions/0"
cat > "$DESTDIR/var/lib/arlen/permissions/0/kg-probe.toml" <<'PROFILE'
# Verify images only. The probe reads exactly what the knowledge app reads, so
# that what it reports is what the app would have seen.
[info]
app_id = "kg-probe"
tier = "first-party"

[graph]
read = [
    "system.Event.id",
    "system.Event.title",
    "system.Event.source",
    "system.Event.timestamp",
    "system.File.id",
    "system.File.path",
    "system.File.app_id",
    "system.File.last_accessed",
    "system.Project.id",
    "system.Project.name",
    "system.Project.root_path",
    "system.Project.created_at",
]
PROFILE
chmod 644 "$DESTDIR/var/lib/arlen/permissions/0/kg-probe.toml"
# No enable symlink here: the unit's own `[Install] WantedBy=multi-user.target`
# above is the enable, and mkosi's preset pass acts on it. The build log shows it
# creating exactly this link in /etc, so writing a second one by hand only added a
# way for the two to disagree - which is what happened to the user units, where a
# hand-kept set drifted one entry from the generated one.
echo ">> staged the verify probes into the image"

# Admit the dogfood driver as a user surface, on THIS image only.
#
# `explain_system` and `completed_actions` are gated to surfaces that ARE the
# system talking to the user, and `dogfood` is not one - correctly, because
# "anything that can name itself" is exactly the admission the list refuses. But
# the AI path is the largest surface we have, and leaving it unexercised is where
# this project keeps finding its defects, so the probe has to be able to call it.
#
# The two tempting answers were both refused (planner, 12 Aug): compiling `dogfood`
# into the release list buys a test's convenience with a permanent widening, and an
# honestly-declared no-op leaves the surface unverified. What differs instead is
# the POLICY, in a file, on the image that needs it - the same shape as the
# kg-probe profile above and for the same reason.
#
# Additive by construction: `arlen_permissions::identity` reads this only to ADD to
# the compiled-in surfaces, so nothing here can remove one. It is read only when
# root-owned and not group- or world-writable, which is what `install -m 644` as
# root gives; a file anyone could rewrite would turn an admission list into a
# self-service one.
#
# The release image ships no such file, and `check-probe-admission.py` fails the
# tree if that stops being true - without that half this is the compiled-in answer
# with extra steps.
# Answer completions from the echo provider on THIS image only.
#
# The AI leg of the dogfood asks a real model through llama-server, and on a
# CPU-only VM that measures the VM: 11.5s for one round trip at ~16 tok/s against
# the explain skill's declared 20s wall budget, so the leg times out every run
# (13 Aug boot). Raising the budget was refused for the right reason - the verify
# image would then exercise a budget the shipped image does not have - and a
# permanently red leg is worse still, because it teaches people to read past a
# failure.
#
# The echo provider answers the question this boot can actually ask: does
# shell -> daemon -> skill -> run -> answer work end to end, admitted, dispatched
# and recorded. It replies in milliseconds and deterministically, so a budget
# breach here means a defect in OUR code rather than slow hardware - which is the
# first time the budget check means anything.
#
# It does NOT measure inference speed, and nothing here should be read as saying
# it does. Real-model latency needs hardware this VM is not.
#
# Safe by construction on the release side: `ai-proxy` reads this at startup, warns
# at WARN when it takes the branch, and every answer OPENS with the echo marker, so
# an echoed reply cannot be mistaken for a model's. The release image ships no
# drop-in, and `check-probe-admission.py` fails the tree if one appears outside a
# verify phase.
mkdir -p "$DESTDIR/usr/lib/systemd/user/arlen-ai-proxy.service.d"
cat > "$DESTDIR/usr/lib/systemd/user/arlen-ai-proxy.service.d/10-echo.conf" <<'ECHOCONF'
# Verify images only, staged by mkosi.build.d/09-verify-probes.sh.chroot.
# Completions are answered in process; no model is contacted.
[Service]
Environment=ARLEN_AI_ECHO=1
ECHOCONF
chmod 644 "$DESTDIR/usr/lib/systemd/user/arlen-ai-proxy.service.d/10-echo.conf"
echo ">> staged the verify echo provider"

mkdir -p "$DESTDIR/var/lib/arlen/permissions"
cat > "$DESTDIR/var/lib/arlen/permissions/user-surfaces.extra" <<'SURFACES'
# Verify images only, staged by mkosi.build.d/09-verify-probes.sh.chroot.
# Adds to the compiled-in user surfaces; it cannot remove one.
dogfood
SURFACES
chmod 644 "$DESTDIR/var/lib/arlen/permissions/user-surfaces.extra"
echo ">> staged the verify user-surface admission"

# Take journald's rate limit off, and be honest about what that does not fix.
#
# This was written believing the limit was why a boot's serial log stops around
# 7-10s of a ~120s run. It is NOT, and the arithmetic was available before the
# change: that boot logged 1479 lines in seven seconds against a limit of 10000
# per 30s. Measured after, with the limit off, the horizon did not move - 7.1s.
# A fix aimed at a cause nobody confirmed.
#
# What is actually true, from three boots and a read of the guest's own disk:
#
#   the serial console   stops carrying userspace output around 7s while the guest
#                        keeps running - the bar appears at 9s and logs nothing.
#                        Not bandwidth either: 203K over a run with room for 1.3M.
#   the on-disk journal  ends EARLIER, around 3s, because the run kills the guest
#                        rather than shutting it down, so whatever journald had not
#                        written back is simply gone.
#
# So the boot exists in neither place, for two different reasons, and the one that
# can be fixed is the second: an ACPI powerdown before teardown lets journald flush,
# and then the overlay holds the whole run. `verify.py --keep` now leaves the overlay
# for exactly that read.
#
# This file stays because it becomes load-bearing at that moment and not before: a
# full 120s journal with the shell logging zbus handshakes at INFO will pass 10000
# messages far more easily than seven seconds of serial ever did. It is insurance on
# the channel we are moving TO, which is a different claim from the one it shipped
# with, and the release image keeps its limit either way.
mkdir -p "$DESTDIR/usr/lib/systemd/journald.conf.d"
cat > "$DESTDIR/usr/lib/systemd/journald.conf.d/10-verify-no-ratelimit.conf" <<'CONF'
# Verify images only, staged by mkosi.build.d/09-verify-probes.sh.chroot.
# A boot is evidence here, and a dropped message is evidence lost.
[Journal]
RateLimitIntervalSec=0
RateLimitBurst=0
CONF
chmod 644 "$DESTDIR/usr/lib/systemd/journald.conf.d/10-verify-no-ratelimit.conf"
echo ">> staged the verify journald rate-limit override"
