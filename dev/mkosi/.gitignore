# mkosi build outputs, regenerated by `mkosi build --force` - never committed.
/arlen
/arlen.raw
/arlen.efi
/arlen.initrd
/arlen.vmlinuz
/initrd
/initrd.cpio.zst
# Globs, not exact names: the rule below said "never committed" while four
# suffixed variants of buildimg.log were tracked, because ad-hoc runs wrote
# buildimg-1b.log and friends and only the bare name was listed.
/build*.log
/boot*.log
/buildimg*.log
# the Debian tools tree (ToolsTree=default) and its manifest, fetched per build.
/mkosi.tools/
/mkosi.tools.manifest

# Daemon binaries staged into the overlay by build-image.sh (zigbuilt for the
# Debian target). Generated, never committed; arlen-session (a source script in
# the same dir) stays tracked.
/mkosi.extra/usr/bin/event-bus
# persistent cargo cache for mkosi.build (registry + target dir)
/mkosi.builddir/
# incremental cache (post-distro base image), reused across builds (--incremental)
/mkosi.cache/
