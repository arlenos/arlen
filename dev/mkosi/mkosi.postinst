#!/bin/sh
# Runs inside the assembled rootfs. The only thing it does is create the autologin
# user: it cannot be expressed as a static overlay file the way the unit-enable
# symlinks can (those ship via mkosi.extra/etc/systemd/, copied verbatim into the
# rootfs - mkosi's postinst sandbox mounts the rootfs /etc read-only for new
# top-level dirs like /etc/systemd, so symlinking there from here fails).
set -eu

# The user greetd's [initial_session] auto-logs in. video/input/render give DRM +
# evdev access; the logind session grants the seat (libseat -> logind). useradd
# leaves the shadow password as `!` (locked) when none is given, so no separate
# passwd --lock (which fails "Permission denied" in mkosi's rootless userns); the
# chown-on-home "Invalid argument" warning is benign (mkosi remaps the uid on the
# final image). Login is only ever the unattended [initial_session].
if ! id arlen >/dev/null 2>&1; then
    # systemd-journal: arlen-journald-parser (a USER service) reads the SYSTEM
    # journal. A user-manager service cannot gain a supplementary group itself
    # (no CAP_SETGID -> "Changing group credentials failed"), so membership must
    # come from the login session: adding arlen to systemd-journal here makes its
    # user session (and every user service it spawns) inherit journal read access.
    useradd --create-home --shell /bin/bash --groups video,input,render,systemd-journal arlen
fi

# The per-uid permission directories are shipped as an overlay, and an overlay
# carries whatever mode the checkout had - 0755, which is listable by anybody.
# `permission-helper` creates the same directories at 0711 on purpose and says
# why in its own code: root-write-only, owner-traversable, NOT listable by
# others, because a profile is a capability declaration rather than a secret and
# integrity is the property being protected. A shipped image should not disagree
# with the component that owns the rule.
#
# THE ROOT IS NOT ASSUMED. The first version of this used `/var/lib/...` and the
# built image still shipped 0755 - read straight out of the raw with guestfish,
# so the boot was not involved and the chmod simply never reached the tree. Which
# root a postinst script sees is a mkosi detail worth measuring rather than
# believing, so this tries `$BUILDROOT` first, falls back to `/`, and SAYS which
# one it found. A silent `[ -d ]` guard is how the first attempt failed without
# telling anybody.
for root in "${BUILDROOT:-}" ""; do
    dir="$root/var/lib/arlen/permissions"
    if [ -d "$dir" ]; then
        chmod 0755 "$dir"
        for d in "$dir"/*/; do
            [ -d "$d" ] && chmod 0711 "$d"
        done
        echo ">> permission dirs set to 0755/0711 under ${root:-/}"
        break
    fi
    echo ">> no permission dirs under ${root:-/}"
done
