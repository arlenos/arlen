# Nested-compositor screenshot loop (autonomous-verify-pipeline-plan.md primary loop):
# boot cosmic-comp nested in Xvfb, launch a Wayland CLIENT under it, grim-capture to
# OUT, then INSPECT the PNG yourself (the metal-verify behavioural rule - your own
# vision, not deferred to a human). Capture is grim >= 1.5 over
# ext-image-copy-capture-v1 (auto-negotiated; the fork's only capture protocol, no
# force flag). Optional env on the script: SHOOT_INJECT (ydotool/wtype, needs
# /dev/uinput - the one sudo: modprobe uinput + udev rule + ydotoold), SHOOT_BASELINE
# + SHOOT_TOLERANCE (magick-compare AE tripwire), SHOOT_SETTLE, SHOOT_CLIENT_LOG.
# Needs a built cosmic-comp at COMPOSITOR_PATH (default ~/Repositories/compositor) +
# Xvfb + grim. Verified working: boot -> capture -> inspect renders the compositor
# SSD chrome (titlebar window-controls, window_corners, border) + the client.
#   just screenshot-nested /tmp/shot.png kitty
screenshot-nested out client *args:
    COMPOSITOR_PATH="${COMPOSITOR_PATH:-$HOME/Repositories/compositor}" \
        "{{justfile_directory()}}/screenshot/shoot-compositor.sh" "{{out}}" {{client}} {{args}}

# Every confinement path this repo has, exercised for real: the launcher, the
# arbitrary-command sandbox, and the decoder workers. All `#[ignore]`d, so they run
# only here - and all of them run on an ordinary developer machine with bwrap,
# pasta and Landlock present, despite being filed as needing metal.
#
# Worth running after any change to a confinement profile, a seccomp allowlist or
# the spawn path. Reading those does not tell you whether a real program fits
# through them: the command sandbox could not execute a single dynamically linked
# binary while its unit tests passed, and two separate seccomp allowlists refused
# the POSIX timers while their comments said "timers".
#
# Expect ONE failure today: `killing_the_launcher_kills_the_confined_tree`. It is a
# true defect, not an environment gap - the confined tree outlives a SIGKILLed
# launcher because the teardown chains PDEATHSIG through pasta, two levels deep.
# Sampling the tree while it runs puts a clock on it: the outer bwrap reaches
# ppid 1 within about 50ms of starting, before anything is killed at all, so the
# signal has nothing left to fire on by the time the launcher dies. That is also
# why it passes about half the time - a run whose kill lands inside that window
# still tears the tree down. See the test's own doc comment and coder-reports.
#
# Run every confinement path for real (expect one known failure).
confinement-check:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{ROOT}}"
    echo "== arlen-run (launcher, landlock, netns, seccomp) =="
    (cd daemons/arlen-run && cargo test -- --ignored --test-threads=1) || true
    echo "== terminal-run-mcp (the run_command sandbox) =="
    (cd daemons/terminal-run-mcp && cargo test --test confined_exec -- --ignored --test-threads=1) || true
    echo "== viewers (the decoder workers) =="
    just --justfile "{{justfile()}}" viewers-decode-check || true

# The confined decoder workers against real fixtures, on-kernel (`#[ignore]`d, so
# they only run here). Each worker decodes UNDER its installed seccomp filter, so a
# pass also proves the tight per-decoder allowlist permits a real decode - the one
# thing reading the allowlist cannot tell you.
#
# The paths must be ABSOLUTE: the test process does not run in this directory, and
# a relative fixture path fails as a missing file rather than a decode error, which
# reads like a broken worker.
#
# Decode a real PNG, JXL, AVIF and WAV in their sandboxes.
viewers-decode-check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ROOT}}"
    for c in decode-image decode-jxl decode-heic decode-audio; do
        cargo build -q --manifest-path "apps/viewers/$c/Cargo.toml"
    done
    D="{{ROOT}}/target/debug"; F="{{ROOT}}/apps/viewers"
    ARLEN_VIEWERS_WORKER_DIR="$D" ARLEN_VIEWERS_TEST_PNG="${ARLEN_VIEWERS_TEST_PNG:-/usr/share/pixmaps/archlinux-logo.png}" \
    ARLEN_VIEWERS_JXL_DIR="$D"    ARLEN_VIEWERS_TEST_JXL="$F/decode-jxl/tests/fixtures/tiny.jxl" \
    ARLEN_VIEWERS_HEIC_DIR="$D"   ARLEN_VIEWERS_TEST_HEIC="$F/decode-heic/tests/fixtures/tiny.avif" \
    ARLEN_VIEWERS_AUDIO_DIR="$D"  ARLEN_VIEWERS_TEST_AUDIO="$F/decode-audio/tests/fixtures/tiny.wav" \
        cargo test --manifest-path apps/viewers/host/Cargo.toml -- --ignored --test-threads=1

