# Reclaim disk by removing the regenerable backend build caches. The per-crate
# `target/` dirs (each standalone workspace builds its own) balloon to tens of GB
# and have repeatedly filled the disk mid-build. This cleans the backend daemons +
# sdk + forage + the integration harness - NOT `apps/*` (arlen-ui's frontend build
# loop) and NOT `ai/` (the active AI lane) - so it frees the bulk without forcing a
# rebuild of what is in active use. Everything removed rebuilds on next `cargo
# build`/`just dev`. Run before a heavy stack build or VM/verify run that needs
# headroom. Reports freed space.
reclaim-disk:
    #!/usr/bin/env bash
    set -uo pipefail
    before=$(df -P "{{ROOT}}" | awk 'NR==2{print $4}')
    for t in "{{ROOT}}"/daemons/*/target "{{ROOT}}"/sdk/target "{{ROOT}}"/forage/target "{{ROOT}}"/dev/integration/target; do
        [ -d "$t" ] || continue
        echo "rm $t ($(du -sh "$t" 2>/dev/null | cut -f1))"
        rm -rf "$t"
    done
    after=$(df -P "{{ROOT}}" | awk 'NR==2{print $4}')
    freed=$(( (after - before) / 1024 / 1024 ))
    echo "reclaimed ~${freed} GiB; df now:"; df -h "{{ROOT}}" | tail -1
    echo "NB the cleaned crates rebuild on next cargo build / just dev."

# One dependency added to a shared crate leaves every standalone lockfile that
# depends on it behind, and nothing notices because a normal build just rewrites
# the lock. Six had drifted that way. This is minutes, not seconds, so it is its
# own recipe rather than part of `lint`.
check-locks:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{ROOT}}"
    stale=()
    for lk in $(git ls-files '*Cargo.lock'); do
        d=$(dirname "$lk")
        out=$(cargo metadata --locked --offline --format-version 1 --manifest-path "$d/Cargo.toml" 2>&1 >/dev/null)
        # An uncached crate is an offline artefact, not a stale lock; only the
        # refusal to rewrite means the lock no longer describes the manifest.
        if grep -q 'because --locked was passed' <<<"$out"; then stale+=("$d"); fi
    done
    if [ ${#stale[@]} -gt 0 ]; then
        printf 'lockfile no longer describes its manifest:\n'
        printf '  - %s\n' "${stale[@]}"
        printf 'run `cargo update --workspace` in each, then test and commit the lock\n'
        exit 1
    fi
    echo "every tracked lockfile still describes its manifest"

# A tracked file that an ignore rule also matches means one of the two is wrong,
# and git will not tell you unasked: ignore rules do not apply to files already
# tracked. Three found this way in one morning - the mkosi build logs matched by
# exact name, and sdk excluding lockfiles two CI-built packages need.
check-ignores:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ROOT}}"
    tracked=$(git ls-files --ignored --exclude-standard -c)
    if [ -n "$tracked" ]; then
        echo "tracked, yet matched by an ignore rule:"
        printf '  %s\n' $tracked
        echo
        echo "either untrack the file or narrow the rule; git applies neither on its own"
        exit 1
    fi
    echo "no tracked file is matched by an ignore rule"

# `event.proto` lives in eight copies because there is no crate for it yet, and a
# copy missing a field is fine (it decodes to the default). Two copies giving one
# field two NUMBERS is not: that is a silent mis-decode across a socket, and the
# copies are only ever compiled separately so nothing else would notice.
check-protos:
    python3 "{{ROOT}}/dev/scripts/check-proto-drift.py"

# The structural checks that need no build, in one command: under four seconds
# for all four, so there is no reason not to run them before pushing. Each one
# exists because the thing it checks had already drifted once - the justfile fell
# behind the CI matrix, build logs were committed against their own ignore rule,
# a unit ordered against a name no unit provides, and eight proto copies agreed
# only by luck. `check-locks` is deliberately not here: it is minutes, not
# milliseconds. Neither is `lint-licenses`, which needs cargo-deny and reuse.
checks:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{ROOT}}"
    status=0
    for r in check-crates check-ignores check-protos check-units; do
        echo "== $r =="
        just --justfile dev/justfile "$r" || status=1
    done
    exit "$status"
