[Unit]
Description=Arlen Graph Daemon
Documentation=https://github.com/arlenos/knowledge
After=arlen-event-bus.service

[Service]
Type=simple
ExecStart=/usr/bin/arlen-graph-daemon
Restart=on-failure
RestartSec=1

# Paths. The daemon reads ARLEN_GRAPH_PATH (not ARLEN_GRAPH_DB) and binds its
# read-query socket at knowledge.sock; the knowledge-mcp server connects to the
# same path, so the two units must agree on it.
Environment=ARLEN_DAEMON_SOCKET=/run/user/%U/arlen/knowledge.sock
Environment=ARLEN_GRAPH_PATH=%h/.local/share/arlen/graph
Environment=ARLEN_DB_PATH=%h/.local/share/arlen/events.db
Environment=RUST_LOG=info

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# NOT read-only, and not an oversight: reading the user's home is this daemon's
# PURPOSE (project detection, file.opened path promotion, the ~/.timeline FUSE
# mount). Verified on a booted image: as a system service with
# ProtectHome=read-only it could not read /home/<user> at all - graph.toml under
# ~/.config came back "not found" while the --user AI daemons read ai.toml from
# the same directory. The capability-scoped query socket is this daemon's access
# boundary, not ProtectHome.
ProtectHome=no
ReadWritePaths=%h/.local/share/arlen
ReadWritePaths=/run/user/%U/arlen
# RESOLVED, and the resolution is not the one this note used to propose. It said
# the remaining half wanted mount propagation - `PrivateMounts=no` or a shared
# `MountFlags` - which was ruled out on 12 Aug: it buys visibility by letting a
# hardened unit reach the host's mount namespace, trading the sandbox for a
# presentation detail in the unit whose sandbox matters most.
#
# The mount left instead. `arlen-timeline` owns it (it needs the SUID
# `fusermount3` and is unfenced by design), and this daemon serves the data over
# its socket. Nothing here mounts anything, and no propagation directive belongs
# in this file. The image copy carries the same paragraph, which is how the two
# stay one decision rather than two.

[Install]
WantedBy=default.target
