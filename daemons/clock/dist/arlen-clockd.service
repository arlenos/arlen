[Unit]
Description=Arlen clock daemon (user service)
Documentation=https://github.com/arlenos/arlen
# arlen-clockd owns the alarms, timers, focus session and stopwatch. The clock
# app is a view onto it and may be closed at any time; an alarm that stops
# existing when a window closes is not an alarm, which is why the state lives
# here and is written to ~/.local/state/arlen/clock.
# Ordered after the power daemon, and only ordered - not required. The clock
# asks Power1 at startup whether alarms can wake this machine and renders the
# answer as a standing line in the app, so starting first would make it say
# "this machine will not be woken" until the next resume refreshed it. If powerd
# never comes up the clock still runs and still keeps time; it simply reports the
# honest degraded state.
After=arlen-powerd.service

[Service]
# Type=dbus: started once it owns its bus name, which is what the app connects
# to.
Type=dbus
BusName=org.arlen.Clock1
# Production binary path (system-wide install), matching the canonical
# path_to_app_id entry that resolves this daemon to `clockd` - the id both the
# power daemon's schedule_wake grant and the notification daemon's Critical
# allowlist key on. Installing it anywhere else silently costs the clock both.
ExecStart=/usr/lib/arlen/libexec/arlen-clockd
# A missing per-user state directory exits non-zero (a clock that silently
# forgets every alarm on restart is worse than one that refuses to start);
# restart with back-off so a persistent fault surfaces rather than crash-looping.
Restart=on-failure
RestartSec=2

# EAGER, not D-Bus activated, and that is the whole point of it being a service.
# A lazily-activated clock starts when something asks for it, and nothing asks
# at 07:00 - the alarm set last night would never ring. WantedBy=default.target
# below is what makes the alarm real.

# No AmbientCapabilities=CAP_WAKE_ALARM here, deliberately: this daemon never
# arms a wake itself. It asks org.arlen.Power1, which owns suspend policy and is
# the single unit that carries that capability. Adding it here would put a second
# holder of the same authority in the system for no gain.

# The mount-namespace options (ProtectSystem, ProtectHome, PrivateTmp,
# PrivateDevices, ProtectKernel*) are omitted, as they are on the audit daemon,
# the consent broker, the AI engine, capsuled and powerd. Their stated reason is
# that such a namespace makes /proc/<pid>/exe unreadable to a same-uid peer and
# so breaks the app-id resolution those daemons depend on; here the clock is the
# side being resolved - powerd reads /proc/<clockd-pid>/exe to check the
# schedule_wake grant, and the notification daemon reads it to decide whether a
# ringing alarm may pierce Do-Not-Disturb - so the same reason applies in the
# other direction. Following the convention is the safe choice: this daemon holds
# no secret, keeps its state under ~/.local/state/arlen/clock by its own code,
# and would gain little from the isolation while risking both of those lookups.
# (A spot-check on this host did not reproduce the EACCES those units describe;
# that is written up in coder-reports rather than acted on here, since five
# daemons rest on it and one measurement is not enough to move them.)
# The hardening that does NOT create a mount namespace is kept.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
