[Unit]
Description=Arlen Audit Daemon (user service)
Documentation=https://github.com/arlenos/audit-daemon
# The daemon re-emits audit.* events on the Event Bus. This is a
# best-effort dependency, not a hard one: the daemon serves its
# sockets and writes the ledger whether or not the bus is up, so
# `After=` orders startup without `Requires=` blocking it.
After=arlen-event-bus.service

[Service]
# `Type=notify`: the daemon calls sd_notify(READY=1) once both the
# ingest and read sockets are bound, so dependent units (the AI
# layer) do not connect before the audit log is ready to record.
Type=notify
# Production binary path (system-wide install). Dev runs invoke the
# debug binary directly; this file is the canonical production unit.
# The producer socket, pinned: `event-bus` is a SYSTEM service binding under
# /run/arlen, while this is a USER service whose $XDG_RUNTIME_DIR fallback dials
# /run/user/<uid>/arlen/ - a path nothing binds. This daemon's own source comments
# on that fallback and then relied on it. Found by `check-bus-socket-pins.py`,
# which exists because the earlier fix went to the daemon whose log was read
# rather than to every daemon with the shape.
# NO SOCKET PINS since 15 Aug: the bus is a per-user service, so the SDK's default
# of $XDG_RUNTIME_DIR/arlen/ is where it actually binds. These lines used to point
# at /run/arlen because the bus was a system unit, and a user service that did not
# pin them dialled a path nothing bound - silently, forever. Keeping them now would
# recreate that defect pointing the other way.
ExecStart=/usr/lib/arlen/libexec/arlen-auditd
Restart=on-failure
RestartSec=2

# Stamped-identity ENFORCE for the ingest trust root. The audit ledger is the
# root every fail-closed audit depends on, so it is the first socket cut over
# from the racy SO_PEERCRED-pid resolution to the pidfd-pinned resolver
# (ConnectionAuth reads ARLEN_STAMPED_IDENTITY per process). Its ADMITTED
# producers are all system daemons at canonical /usr/lib/arlen/libexec paths, so
# the stamped app_id equals the legacy one by construction (no rule-4 inode gate
# involved); a shadow boot confirmed zero divergence and that SO_PEERPIDFD is
# available on the target kernel. Enforce fails closed: an unresolvable pidfd
# denies the ingest rather than falling back to the weaker path.
Environment=ARLEN_STAMPED_IDENTITY=enforce

# The audit daemon authenticates each ingest peer by resolving its
# /proc/<pid>/exe against the producer allowlist (SO_PEERCRED gives the PID;
# the exe is the identity). A mount-namespace sandbox (ProtectSystem,
# ProtectHome, PrivateTmp, PrivateDevices, ProtectControlGroups,
# ProtectKernel*) makes /proc/<other-pid>/exe unreadable to a same-uid reader,
# so those options break peer auth outright (the daemon then resets every
# ingest and the AI layer's fail-closed audit refuses every query). They are
# therefore intentionally OMITTED, the same as the consent broker and the AI
# engine omit them for the identical reason. The hardening that does NOT create
# a mount namespace is kept; the ledger's integrity rests on its HMAC key +
# hash chain, not on filesystem isolation. Without ProtectSystem there is no
# ReadWritePaths to mismatch; the daemon create_dir_all's its own per-user
# ledger dir on first run.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
