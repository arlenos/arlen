[Unit]
Description=Arlen Event Bus (this session's event funnel)
Documentation=https://github.com/arlenos/arlen
# PER-USER since 15 Aug, and the second half of moving the knowledge daemon.
#
# The bus used to be one system service at /run/arlen/, which every session
# component connected to. That is a single funnel carrying one machine's whole
# activity: every user's events crossed it, isolation rested entirely on a filter,
# and one user could flood the channel everyone else's graph depends on.
#
# Now each session gets its own, bound under $XDG_RUNTIME_DIR/arlen/ - which is
# where the SDK already looked by default, so its clients needed no change. What
# needed changing was the units that PINNED them back to /run/arlen to compensate.
#
# A whole-machine observer still cannot be per-user: the eBPF kernel layer watches
# every process by definition. That case is served the other way round - it keeps
# publishing to a system bus and this one subscribes to it, filtered to this
# session's uid, via ARLEN_UPSTREAM_CONSUMER_SOCKET. Unset here because no such
# observer ships yet; the forwarder stays quiet without it rather than retrying at
# a socket nobody binds.

[Service]
# Subscribe to the system instance, so machine-wide producers reach this session.
# The eBPF sensor runs as root before any session exists and cannot publish to a
# per-user bus; it publishes to `arlen-event-bus-system.service`, and this
# forwards from there.
#
# `/run/arlen` is not image topology - it is where the system instance binds on
# any deployment, because a system unit has no XDG_RUNTIME_DIR and the resolver
# falls there by design.
Environment=ARLEN_UPSTREAM_CONSUMER_SOCKET=/run/arlen/event-bus-consumer.sock
Type=simple
ExecStart=/usr/bin/event-bus
Restart=on-failure

# RuntimeDirectory=, and dropping it is what broke the first per-user boot.
#
# The daemon does create its own socket directory - `socket.rs:748` calls
# `create_dir_all` on the parent - so this looked redundant, and the unit shipped
# without it. Then `ProtectSystem=strict` remounts everything read-only including
# %t, the create failed with `Read-only file system`, and the bus restarted in a
# loop while every client logged `No such file or directory`. Nothing said the two
# directives were related; the boot did.
#
# systemd creates %t/arlen BEFORE the read-only remount, which is the whole point
# of the directive. Preserve=yes because the directory is shared with the other
# per-user daemons and systemd does not ref-count it.
RuntimeDirectory=arlen
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Hardening: a pure AF_UNIX IPC daemon - no filesystem write beyond its socket
# dir, no network, no privilege escalation.
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=default.target
