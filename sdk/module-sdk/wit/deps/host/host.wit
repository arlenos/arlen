/// Host imports surfaced to Tier 1 WASM modules.
///
/// Every function here is capability-gated: the host (`arlen-modulesd`)
/// only links the imports a module's manifest declares in
/// `[capabilities]`. An undeclared capability is not just runtime-denied,
/// the import is missing and the link step rejects the module before it
/// runs. This is the strongest form of capability enforcement: what is
/// not declared, does not exist.
package arlen:host@0.1.0;

interface graph {
    /// Read-only Cypher query against the Knowledge Graph.
    /// Capability: `graph.read = [...]` (allowlist of namespaces).
    query: func(cypher: string) -> result<string, error>;

    /// Write to the Knowledge Graph.
    /// Capability: `graph.write = [...]` (allowlist of namespaces).
    /// The host enforces namespace scoping before executing.
    write: func(cypher: string) -> result<string, error>;

    record error {
        code: error-code,
        message: string,
    }

    enum error-code {
        denied,
        invalid-query,
        timeout,
        internal,
    }
}

interface network {
    /// HTTP GET. Returns response body on success.
    /// Capability: `network.allow = [domain, ...]`. Host rejects URLs
    /// whose host does not match any allowlist entry.
    fetch: func(url: string, headers: list<tuple<string, string>>)
        -> result<list<u8>, error>;

    /// HTTP POST with JSON body.
    post: func(
        url: string,
        body: list<u8>,
        headers: list<tuple<string, string>>,
    ) -> result<list<u8>, error>;

    record error {
        code: error-code,
        message: string,
    }

    enum error-code {
        denied,
        not-allowed,
        timeout,
        connection-failed,
        invalid-response,
    }
}

interface events {
    /// Emit an event to the Arlen Event Bus.
    /// Capability: `event_bus.publish = [namespace, ...]`. The host
    /// rejects event types whose namespace prefix does not match.
    emit: func(event-type: string, payload: list<u8>) -> result<_, error>;

    record error {
        code: error-code,
        message: string,
    }

    enum error-code {
        denied,
        invalid-payload,
        bus-disconnected,
    }
}

interface files {
    /// Read a file whole.
    ///
    /// Capability: `files.read = [prefix, ...]`, path prefixes the way
    /// `network` declares domains. Undeclared means the import is not linked
    /// and the module does not run.
    ///
    /// The host canonicalises the argument with symlinks resolved BEFORE
    /// checking, so a link inside an allowed prefix cannot point out of it, and
    /// refuses a deny-listed path whatever the manifest says. Read only: there
    /// is no write, create, delete, or stat beyond what a listing carries.
    read: func(path: string) -> result<list<u8>, error>;

    /// List a directory. `man` cannot find a page without one.
    ///
    /// Named `list-dir` rather than `list`, which WIT reserves for the list
    /// type and rejects as a function name.
    list-dir: func(path: string) -> result<list<entry>, error>;

    record entry {
        /// The entry's name, not its path: a guest joins it to what it asked
        /// for rather than being handed somewhere it did not ask about.
        name: string,
        /// Whether it is a directory, so a guest can walk without a stat call.
        directory: bool,
        /// Size in bytes, zero for a directory.
        size: u64,
    }

    record error {
        code: error-code,
        message: string,
    }

    enum error-code {
        /// The path is under something no manifest may name.
        denied,
        /// The path is outside every prefix this module declared.
        not-allowed,
        /// Absent, or a link that goes nowhere.
        not-found,
        /// Present and unreadable: permissions, or a device that will not read.
        unreadable,
        /// Larger than the host will hand a guest in one call.
        too-large,
    }
}

interface log {
    /// Logging is unconditionally allowed. Goes to the daemon's stderr
    /// tagged with the module ID; the user can read it in Settings.
    info:  func(message: string);
    warn:  func(message: string);
    error: func(message: string);
}
