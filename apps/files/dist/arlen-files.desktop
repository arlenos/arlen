[Desktop Entry]
Type=Application
Version=1.5
Name=Files
Name[de]=Dateien
Comment=Browse, search and organise your files
Comment[de]=Dateien durchsuchen und ordnen
Exec=arlen-files
Icon=arlen-files
Terminal=false
Categories=System;FileTools;FileManager;
Keywords=file;manager;folder;browse;
Keywords[de]=datei;ordner;verwalten;
StartupNotify=true
# The identity the permission system keys on. The resolver maps a canonical
# /usr/bin/arlen-{name} binary to {name}, so the profile, the audit actor and
# every capability check for this app say `files` - while the desktop-id this
# file would otherwise imply is its basename, `arlen-files`. Stating it here
# keeps the launcher's idea of who this app is identical to the daemons',
# rather than two names for one app that only diverge under confinement.
X-Arlen-AppId=files
