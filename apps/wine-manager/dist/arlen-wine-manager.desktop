[Desktop Entry]
Type=Application
Version=1.5
Name=Windows programs
Name[de]=Windows-Programme
Comment=Run a Windows program in a bottle that reaches only what you granted
Comment[de]=Ein Windows-Programm in einer Flasche starten, die nur erreicht was Sie freigegeben haben
Exec=arlen-wine-manager %f
Icon=arlen-wine-manager
Terminal=false
Categories=System;
Keywords=windows;wine;exe;bottle;prefix;
Keywords[de]=windows;wine;exe;flasche;prefix;
StartupNotify=true

# `application/x-ms-dos-executable` is NOT claimed yet. Double-clicking an .exe is
# the on-ramp the plan describes, and claiming the type before the app can run one
# is how a file manager comes to hand a program to something that ignores it. It
# goes in when launching from a path works end to end.

# The id the resolver derives from the installed binary, stated here so the
# launcher and every daemon that admits by app id cannot disagree about who this
# app is.
X-Arlen-AppId=dev.arlen.wine-manager
