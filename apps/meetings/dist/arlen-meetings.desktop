[Desktop Entry]
Type=Application
Version=1.5
Name=Meetings
Name[de]=Besprechungen
Comment=Record meetings and keep their notes
Comment[de]=Besprechungen aufzeichnen und Notizen behalten
Exec=arlen-meetings
Icon=arlen-meetings
Terminal=false
Categories=Office;
Keywords=meeting;notes;transcript;recording;
Keywords[de]=besprechung;notizen;transkript;
StartupNotify=true
# The identity the permission system keys on. The resolver maps a canonical
# /usr/bin/arlen-{name} binary to {name}, so the profile, the audit actor and
# every capability check for this app say `meetings` - while the desktop-id this
# file would otherwise imply is its basename, `arlen-meetings`. Stating it here
# keeps the launcher's idea of who this app is identical to the daemons',
# rather than two names for one app that only diverge under confinement.
X-Arlen-AppId=dev.arlen.meetings
