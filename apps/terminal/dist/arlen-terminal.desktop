[Desktop Entry]
Type=Application
Version=1.5
Name=Terminal
Name[de]=Terminal
Comment=Run commands in a shell
Comment[de]=Befehle in einer Shell ausführen
Exec=arlen-terminal
Icon=arlen-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;command;prompt;console;
Keywords[de]=shell;befehl;konsole;
StartupNotify=true
# The identity the permission system keys on. The resolver maps a canonical
# /usr/bin/arlen-{name} binary to {name}, so the profile, the audit actor and
# every capability check for this app say `terminal` - while the desktop-id this
# file would otherwise imply is its basename, `arlen-terminal`. Stating it here
# keeps the launcher's idea of who this app is identical to the daemons',
# rather than two names for one app that only diverge under confinement.
X-Arlen-AppId=terminal
