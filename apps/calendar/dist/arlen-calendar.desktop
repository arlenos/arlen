[Desktop Entry]
Type=Application
Version=1.5
Name=Calendar
Name[de]=Kalender
Comment=Your own calendar files, as an agenda
Comment[de]=Deine eigenen Kalenderdateien, als Agenda
Exec=arlen-calendar %f
Icon=arlen-calendar
Terminal=false
# One main category (Office) plus the additional `Calendar`. Naming two main
# categories is what `desktop-file-validate` reports as a hint, and a hint is a
# failure here.
Categories=Office;Calendar;
Keywords=calendar;agenda;events;meetings;appointments;
Keywords[de]=kalender;agenda;termine;besprechungen;
StartupNotify=true

# `text/calendar` is claimed because opening one file now WORKS: launched with a
# path, the agenda is that file's events and the surface names that file. The
# claim was deliberately withheld until then - an app registered for a type it
# would answer by showing something else is an app that ignores what you asked
# it to open.
MimeType=text/calendar;

# The id the resolver derives from the installed binary, stated here so the
# launcher and every daemon that admits by app id cannot disagree about who this
# app is.
X-Arlen-AppId=dev.arlen.calendar
X-Arlen-SingleInstance=true
