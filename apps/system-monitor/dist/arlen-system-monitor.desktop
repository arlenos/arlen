[Desktop Entry]
Type=Application
Version=1.5
Name=System Monitor
Name[de]=Systemmonitor
Comment=Watch processes, memory and load
Comment[de]=Prozesse, Speicher und Last beobachten
Exec=arlen-system-monitor
Icon=arlen-system-monitor
Terminal=false
Categories=System;Monitor;
Keywords=process;cpu;memory;load;task;
Keywords[de]=prozess;speicher;last;
StartupNotify=true
# The identity the permission system keys on. The resolver maps a canonical
# /usr/bin/arlen-{name} binary to {name}, so the profile, the audit actor and
# every capability check for this app say `system-monitor` - while the desktop-id this
# file would otherwise imply is its basename, `arlen-system-monitor`. Stating it here
# keeps the launcher's idea of who this app is identical to the daemons',
# rather than two names for one app that only diverge under confinement.
X-Arlen-AppId=system-monitor
