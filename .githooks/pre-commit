#!/usr/bin/env bash
# Run the structural gates CI declares, before the commit rather than after it.
#
# This existed as a script and not as a hook, which is the same as not existing.
# On the night of 9 August a stale inventory entry reached CI; on the 10th an
# image change of mine turned `check-app-profiles` red and sat there for an hour
# while I committed four more times over the top of it. Both were caught by gates
# that were already written and already correct - nothing ran them.
#
# It is the CI list, read out of the workflow at run time rather than kept here,
# so a gate added to CI is picked up without anyone remembering to add it twice.
# Roughly fifteen seconds; the gates run concurrently for exactly that reason.
#
# `git commit --no-verify` skips it. That is deliberate and not a loophole: a
# hook with no escape gets uninstalled the first time it is wrong, and then it
# protects nothing.
#
# What this does NOT cover, found by walking into it within the minute: the gates
# read the WORKING TREE, not the index. So a partly-staged commit - a file staged
# in one state and edited into another - is judged on the state on disk, and can
# pass here while landing something else. That is how a throwaway line proving
# this hook fires ended up inside the commit that added the hook. Staging the
# whole file is the habit that avoids it; `git stash --keep-index` around the run
# would close it properly, and is not done here because a stash that fails midway
# costs more than the gap does.
#
# So the gap is NAMED instead. `warn_divergence` lists the files this ran against
# a different version of, every time it happens, whether the gates passed, failed
# or never ran. It does not block: partial staging is legitimate and a hook that
# refuses it gets bypassed, after which it protects nothing. What it removes is
# the silence - a green run above no longer implies the thing being committed is
# the thing that was checked, and now says so rather than leaving it to be
# remembered from a comment nobody reads at commit time.
set -uo pipefail

root=$(git rev-parse --show-toplevel)
runner="$root/dev/scripts/run-ci-gates.sh"

# Files that are BOTH staged and further edited since: `git diff` is worktree
# against index, `git diff --cached` is index against HEAD, so the intersection is
# exactly the set whose on-disk state is not the committed state.
divergent=$(comm -12 \
    <(git diff --name-only | sort) \
    <(git diff --cached --name-only | sort))

warn_divergence() {
    [ -n "$divergent" ] || return 0
    echo >&2
    echo "pre-commit: checked the version on disk, not the version being committed:" >&2
    printf '%s\n' "$divergent" | while IFS= read -r f; do
        [ -n "$f" ] && echo "  $f" >&2
    done
    echo "  Each is staged in one state and edited into another, so the result above" >&2
    echo "  says nothing about what lands. Stage the whole file, or check it yourself." >&2
}

# Absent runner: say so and let the commit through. The hook is a safety net, and
# a net that blocks work when its own plumbing is missing is worse than none.
if [ ! -f "$runner" ]; then
    echo "pre-commit: $runner is missing; gates not run" >&2
    warn_divergence
    exit 0
fi

if ! bash "$runner"; then
    echo >&2
    echo "pre-commit: a structural gate is red, so this commit would land broken." >&2
    echo "Fix it, or pass --no-verify if you know why it is wrong." >&2
    warn_divergence
    exit 1
fi

# What a change to a SHARED crate breaks somewhere else.
#
# The sibling gap to the one below, and found the same way - by walking into it. A
# commit that changes a public signature in `sdk/permissions` passes every check
# above while leaving other crates unable to compile, because nothing here looks at
# whether the tree still builds. Narrowed by effect rather than by building
# everything: only `sdk/` and `contracts/` changes can break a crate the commit does
# not touch, so only those pay, and only the crates that path-depend on them are
# checked. Four seconds warm across thirty crates; nothing at all for a commit that
# touches one daemon.
if [ -x "$root/dev/scripts/check-shared-signature.sh" ]; then
    if ! shared_out=$(bash "$root"/dev/scripts/check-shared-signature.sh \
                      $(git diff --cached --name-only) 2>&1); then
        echo >&2
        printf '%s\n' "$shared_out" | tail -20 >&2
        warn_divergence
        exit 1
    fi
    # Only say something when it did work; silence on the fast path.
    printf '%s' "$shared_out" | grep -q "affected crate" && printf '%s\n' "$shared_out" | tail -1
fi

# The one CI check that is a crate TEST rather than a gate script, and therefore
# the one this sweep did not see.
#
# `no_new_daemon_module_is_unreachable` refuses a daemon module nothing calls. It
# fires on exactly the change this hook is least able to notice - adding a crate or
# a module - because the gates above read the tree's shape and this reads the
# tree's references. On 13 Aug it went red twice in two hours, both times on a
# commit that passed everything above it, and both times the author had measured
# CI green BEFORE adding the code that broke it.
#
# Hand-named, against this hook's own read-the-list-from-CI principle, and worth
# it: one entry earned by two reds is a better trade than a rule kept pure. It
# costs about three seconds warm. A missing toolchain or an unbuildable tree lets
# the commit through with a line, like the runner above - the net does not block
# work when its own plumbing is absent.
reach="cargo test --manifest-path $root/dev/integration/Cargo.toml \
       --lib no_new_daemon_module_is_unreachable"
if ! out=$($reach 2>&1); then
    if printf '%s' "$out" | grep -q "daemon modules that compile and test but nothing reaches"; then
        echo >&2
        printf '%s\n' "$out" | grep -A20 "daemon modules that" >&2
        echo "pre-commit: a daemon module nothing reaches would land." >&2
        echo "Wire it up, or name it in KNOWN_UNREACHED with the reason it waits." >&2
        warn_divergence
        exit 1
    fi
    echo "pre-commit: could not run the reachability test (toolchain or build); not run" >&2
fi

warn_divergence
